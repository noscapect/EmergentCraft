# Always keep the Brain loopback-only unless you consciously add another boundary.
HOST=127.0.0.1
PORT=3847
EC_MEMORY_DIR=./data
OLLAMA_MAX_CONCURRENT=1

# Default operational profile; individual residents can override through /ec brain* commands.
EC_PROVIDER=ollama
EC_MODEL_PROFILE=qwen

# Ollama: model is discovered only when blank; startup never pulls weights.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_KEEP_ALIVE=15m
OLLAMA_REQUEST_TIMEOUT_MS=120000

# Andy-4.1 / LM Studio / llama-server: blank model resolves the first discovered local model.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_OPENAI_MODEL=
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_TIMEOUT_MS=120000

# Context and thinking are profile-owned. OLLAMA_NUM_CTX and OLLAMA_THINK are intentionally obsolete.
MEMORY_CONSOLIDATE_AFTER_EVENTS=30
MEMORY_CONSOLIDATION_BATCH=20
